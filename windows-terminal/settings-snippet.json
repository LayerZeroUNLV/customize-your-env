{
  "profiles": {
    "defaults": {
      "colorScheme": "Catppuccin Mocha",
      "font": {
        "face": "JetBrainsMono Nerd Font",
        "size": 13
      },
      "opacity": 92,
      "useAcrylic": true,
      "padding": "12, 10",
      "cursorShape": "bar",
      "antialiasingMode": "cleartype",
      "scrollbarState": "hidden"
    }
  },
  "schemes": [
    {
      "name": "Catppuccin Mocha",
      "cursorColor": "#F5E0DC",
      "selectionBackground": "#585B70",
      "background": "#1E1E2E",
      "foreground": "#CDD6F4",
      "black": "#45475A",
      "red": "#F38BA8",
      "green": "#A6E3A1",
      "yellow": "#F9E2AF",
      "blue": "#89B4FA",
      "purple": "#F5C2E7",
      "cyan": "#94E2D5",
      "white": "#BAC2DE",
      "brightBlack": "#585B70",
      "brightRed": "#F38BA8",
      "brightGreen": "#A6E3A1",
      "brightYellow": "#F9E2AF",
      "brightBlue": "#89B4FA",
      "brightPurple": "#F5C2E7",
      "brightCyan": "#94E2D5",
      "brightWhite": "#A6ADC8"
    }
  ],
  "actions": [
    {
      "command": { "action": "splitPane", "split": "auto" },
      "keys": "alt+shift+enter"
    },
    {
      "command": { "action": "moveFocus", "direction": "left" },
      "keys": "ctrl+alt+h"
    },
    {
      "command": { "action": "moveFocus", "direction": "down" },
      "keys": "ctrl+alt+j"
    },
    {
      "command": { "action": "moveFocus", "direction": "up" },
      "keys": "ctrl+alt+k"
    },
    {
      "command": { "action": "moveFocus", "direction": "right" },
      "keys": "ctrl+alt+l"
    }
  ]
}
